# Copy to .env and fill in what you have. Everything is optional.

# 1 = invented demo data (default). 0 = your real folders, mail and calendar.
JARVIS_DEMO=1
# Live-mode folders, separated by ;
JARVIS_FOLDERS=C:\Users\Yuval\Documents;C:\Users\Yuval\Desktop

# The brain (console.anthropic.com)
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low
# Web search costs $10 per 1,000 searches — opt in
JARVIS_WEB_SEARCH=0

# Voice (elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_v3

# Gmail, read-only (App password, IMAP)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Google Calendar, read-only (Secret address in iCal format)
GCAL_ICS_URL=

JARVIS_PORT=7777
