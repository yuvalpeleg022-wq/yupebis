{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window access and save-game file access limited to the app data folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-remove",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPDATA" }] }
  ]
}
