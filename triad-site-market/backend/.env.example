# Copy to .env and fill in. Never commit .env.
TRIAD_ENV=development
TRIAD_DATABASE_URL=postgresql+psycopg://triad:triad@localhost/triad
TRIAD_REDIS_URL=redis://localhost:6379/0
TRIAD_JWT_SECRET=change-me-to-a-long-random-string
TRIAD_PUBLIC_BASE_URL=http://localhost:3000

# AI: mock (offline procedural engine) | live (Claude + LM Studio + optional Gemini)
TRIAD_AI_MODE=mock
ANTHROPIC_API_KEY=
TRIAD_CLAUDE_MODEL=claude-opus-5-5
TRIAD_LMSTUDIO_BASE_URL=http://localhost:1234/v1
TRIAD_LMSTUDIO_MODEL=local-model
TRIAD_GEMINI_API_KEY=
TRIAD_GEMINI_MODEL=gemini-2.5-flash

# Payments: mock | payplus
TRIAD_PAYMENT_PROVIDER=mock
TRIAD_PAYMENT_WEBHOOK_SECRET=change-me
TRIAD_PUBLIC_API_URL=http://localhost:8000     # must be publicly reachable for PayPlus callbacks
TRIAD_PAYPLUS_API_KEY=
TRIAD_PAYPLUS_SECRET_KEY=
TRIAD_PAYPLUS_PAYMENT_PAGE_UID=
TRIAD_PAYPLUS_TERMINAL_UID=
TRIAD_PAYPLUS_SANDBOX=true
TRIAD_PAYPLUS_ISSUE_INVOICE=true

# Hosting: local | cloudflare (token scope: Account > Cloudflare Pages > Edit)
TRIAD_HOSTING_PROVIDER=local
TRIAD_CLOUDFLARE_API_TOKEN=
TRIAD_CLOUDFLARE_ACCOUNT_ID=
